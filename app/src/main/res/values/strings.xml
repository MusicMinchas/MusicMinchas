    <string name="server_disconnect_dialog_message">The songs from Navidrome will be removed from the library. Plays, favourites and playlists are kept and come back if you connect the same Navidrome server again.</string>
    <string name="server_disconnect_dialog_title">Disconnect Navidrome?</string>
    <string name="server_disconnect_message_with_count">The %1$s from Navidrome will be removed from the library. Plays, favourites and playlists are kept and come back if you connect the same Navidrome server again.</string>
    <string name="server_favourites_playlists_desc">Favourites of Navidrome songs are its starred songs, and your playlists are its playlists: changes on either side go to the other. Songs from this device or Drive go into Navidrome playlists as its copy of the same song.</string>
    <string name="server_hide_password_cd">Hide password</string>
    <string name="server_in_library_info">Sync to add Navidrome\'s songs to the library. They\'re listed apart from other sources; the switch above the library shows either or both.</string>
